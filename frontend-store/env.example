# Frontend Environment Variables (.env.local)
# Copy this file to .env.local and fill in the values

# ============================================================================
# REQUIRED - Application will not work without these
# ============================================================================

# Google OAuth Client ID (Get from Google Cloud Console)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT Secret (CRITICAL - Generate with: openssl rand -base64 32)
# Must be at least 32 characters, must contain letters and numbers
JWT_SECRET=your-jwt-secret-min-32-chars-with-letters-and-numbers123

# ============================================================================
# OPTIONAL - For production monitoring and features
# ============================================================================

# Sentry Error Tracking (Get from sentry.io)
NEXT_PUBLIC_SENTRY_DSN=

# Application Version (for release tracking)
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================================================
# PRODUCTION ONLY
# ============================================================================

# Set to 'production' in production environment
NODE_ENV=development
