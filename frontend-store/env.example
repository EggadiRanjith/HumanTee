# Google OAuth
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Backend API
NEXT_PUBLIC_API_URL=http://localhost:3001

# JWT Secret (minimum 32 characters, must contain letters and numbers)
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-min-32-chars-with-letters-and-numbers123
